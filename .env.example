# Copy to .env and fill in. Never commit .env.

# Required in production: strong random secret for JWT signing (e.g. openssl rand -hex 32)
JWT_SECRET=your-secret-here

# API server port
PORT=3001

# Production: your frontend origin for CORS (e.g. https://yoursite.com)
# WEB_ORIGIN=https://yoursite.com

# Production: API base URL for the frontend (used at build time: npm run build)
# VITE_API_URL=https://api.yoursite.com

# Optional: path for activity log file. Set to empty ("") to log only to console (e.g. on Render free tier).
# ACTIVITY_LOG_PATH=

# Optional: Custom RPC URL for fetching wallet balances (defaults to public RPC)
# RPC_URL=https://eth.llamarpc.com

# Optional: Google OAuth (for "Login with Google")
# Get from https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID, Web application)
# Authorized redirect URI: https://your-api-host/api/auth/google/callback (or http://localhost:3001/api/auth/google/callback for dev)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: Facebook OAuth (for "Login with Facebook")
# Get from https://developers.facebook.com/apps (Facebook Login, Web). Redirect URI: https://your-api-host/api/auth/facebook/callback
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
